  <version>0.1.0</version>
  <description>TensorRT YOLO object detector node publishing vision_msgs/Detection2DArray</description>
  <maintainer email="haiha-ux@users.noreply.github.com">Ha Phan Thanh Hai</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
